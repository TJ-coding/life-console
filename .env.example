# Copy to .env and edit. `docker compose up -d` reads it; `npm run dev:server` / `npm test` too.

# ── required ──
# letters and digits only (it goes into a connection URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# the address people open (no trailing slash); https:// turns on Secure cookies
APP_URL=http://localhost:8080

# ── accounts ──
# Sign in with Google: create an OAuth client (Web application) at https://console.cloud.google.com/apis/credentials
# with the redirect URI  <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# off = Google only: no passwords are accepted or stored (existing ones are deleted at each user's next Google sign-in)
AUTH_PASSWORD=on
# open = anyone can create an account; closed = only the admin CLI can (docker compose exec app node server/cli.mjs create-user …)
SIGNUPS=open
# on = a public landing page at / for visitors who aren't signed in, and robots.txt/sitemap.xml that invite search engines.
# off (default) = / is the app and robots.txt asks crawlers to stay out. The page describes life-console.dev, so leave it off.
LANDING=off
# on (with LANDING=on) = A/B test the landing page: each new visitor gets landing.html or landing-b.html, kept in the lc_lp cookie
LANDING_AB=off
# optional: anonymous Umami statistics for the landing page and the app's screens (each person can opt out in Settings)
# ANALYTICS_SCRIPT=https://umami.example.com/script.js
# ANALYTICS_SITE_ID=
# optional: Umami's recorder.js for a click and scroll heatmap and optional session replays of the landing page only (switch them on for the website in Umami)
# ANALYTICS_RECORDER=https://umami.example.com/recorder.js
# the Umami dashboard's address: lets it show the landing page behind the heatmap (only that page may be framed)
# ANALYTICS_DASHBOARD=https://umami.example.com
# optional: once a day, send anonymous totals (users, DAU/WAU/MAU, churn) to Umami as a `daily-metrics` event,
# computed on the server (no browser involved). UMAMI_URL = Umami as this server reaches it; off when empty.
# The website defaults to ANALYTICS_SITE_ID. See docs/OPERATIONS.md §6.1a.
# UMAMI_URL=http://umami.lan:3000
# UMAMI_WEBSITE_ID=
# comma-separated emails that are admins. If empty, the first account on a fresh install becomes admin;
# if set, only these are (set it on any public server, so a stranger signing up first can't become admin)
ADMIN_EMAILS=
# "Forgot password" emails; leave empty to disable (admins can still reset with the CLI)
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Life Console <no-reply@example.com>

# ── network ──
# host port for the app; use 127.0.0.1:18080 to bind it locally only (behind a proxy such as Traefik/Dokploy)
LC_PORT=8080
# 1 when behind a reverse proxy / Cloudflare, so rate limits see the real client IP
TRUST_PROXY=0

# ── version ──
# LC_IMAGE=ghcr.io/tj-coding/life-console
# latest = newest main build; pin a build (e.g. sha-1a2b3c4) for controlled updates or to roll back
LC_VERSION=latest

# ── backups (the `backup` service) ──
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# ── local development without Docker (npm run dev:server / npm test) ──
# DATABASE_URL=postgres://lifeconsole:change-me@localhost:5432/lifeconsole
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
# PORT=8787
# PUSH_DRY_RUN=1
