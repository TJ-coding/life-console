# Copy to .env and edit. `docker compose up -d` reads it; `npm run dev:server` / `npm test` too.

# ── required ──
# letters and digits only (it goes into a connection URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# the address people open (no trailing slash); https:// turns on Secure cookies
APP_URL=http://localhost:8080

# ── accounts ──
# open = anyone can create an account; closed = only the admin CLI can (docker compose exec app node server/cli.mjs create-user …)
SIGNUPS=open
# comma-separated emails that are always admins (the first account on a fresh install is admin anyway)
ADMIN_EMAILS=
# "Forgot password" emails; leave empty to disable (admins can still reset with the CLI)
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Life Console <no-reply@example.com>

# ── network ──
# host port for the app; use 127.0.0.1:18080 to bind it locally only (behind a proxy such as Traefik/Dokploy)
LC_PORT=8080
# 1 when behind a reverse proxy / Cloudflare, so rate limits see the real client IP
TRUST_PROXY=0

# ── version ──
# LC_IMAGE=ghcr.io/tj-coding/life-console
# latest = newest main build; pin a build (e.g. sha-1a2b3c4) for controlled updates or to roll back
LC_VERSION=latest

# ── backups (the `backup` service) ──
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# ── local development without Docker (npm run dev:server / npm test) ──
# DATABASE_URL=postgres://lifeconsole:change-me@localhost:5432/lifeconsole
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
# PORT=8787
# PUSH_DRY_RUN=1
