{
  "name": "Life Console",
  "short_name": "Life Console",
  "description": "Keyboard-first console for schedules, todos, strategy and wellbeing.",
  "id": "/",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0E1116",
  "theme_color": "#0E1116",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/#/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Plan week", "url": "/#/week", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Deadlines", "url": "/#/deadlines", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
